#!/bin/sh
# Regenerates the generated sections of README.md, AGENTS.md and docs/sprint-1.md,
# stages any file it changed, and blocks the commit if a repo rule is broken.
# Enable once per clone with: make hooks
out=$(python3 tools/docs.py --write) || { echo "$out"; echo "commit blocked: fix the errors above"; exit 1; }
echo "$out"
echo "$out" | sed -n 's/^updated: //p' | while read -r f; do git add "$f"; done
exit 0
